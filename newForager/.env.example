# Copy this file to .env (same folder) and fill in your key. .env is git-ignored;
# this example file is safe to commit because it holds no secrets.

# Your Claude API key, from the Claude Console (console.anthropic.com, "API keys").
ANTHROPIC_API_KEY=

# Optional: the Claude model that writes the analyses (default claude-opus-5-5).
# AI_MODEL=claude-opus-5-5
